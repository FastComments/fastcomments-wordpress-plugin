{
    "name": "fastcomments/fastcomments-wordpress-plugin",
    "description": "FastComments WordPress plugin. Composer is only used for the PHPCS dev tooling, the plugin has no runtime dependencies.",
    "license": "GPL-2.0-or-later",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "automattic/vipwpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "scripts": {
        "post-install-cmd": "git config core.hooksPath .githooks",
        "post-update-cmd": "git config core.hooksPath .githooks",
        "lint": "phpcs"
    }
}
