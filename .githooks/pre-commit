#!/usr/bin/env python3
"""Runs the WordPress VIP coding standards (phpcs.xml.dist) on the staged PHP files and blocks the commit on errors."""
import os
import subprocess
import sys

ROOT = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True, check=True).stdout.strip()
PHPCS = os.path.join(ROOT, 'vendor', 'bin', 'phpcs')

staged = subprocess.run(
    ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z', '--', '*.php'],
    capture_output=True, text=True, check=True, cwd=ROOT
).stdout.split('\0')
staged = [path for path in staged if path and not path.startswith('vendor/')]
if not staged:
    sys.exit(0)

if not os.path.isfile(PHPCS):
    print('pre-commit: PHPCS is not installed. Run `composer install` in the plugin root.', file=sys.stderr)
    sys.exit(1)

failed = False
for path in staged:
    # Lint the staged blob, not the working tree, so partially staged files are checked as they will be committed.
    content = subprocess.run(['git', 'show', ':' + path], capture_output=True, check=True, cwd=ROOT).stdout
    result = subprocess.run(
        [PHPCS, '--standard=' + os.path.join(ROOT, 'phpcs.xml.dist'), '--warning-severity=0', '--stdin-path=' + path, '-'],
        input=content, capture_output=True, cwd=ROOT
    )
    if result.returncode != 0:
        failed = True
        sys.stdout.write(result.stdout.decode('utf-8', 'replace'))
        sys.stderr.write(result.stderr.decode('utf-8', 'replace'))

if failed:
    sys.stdout.flush()
    print('pre-commit: fix the WordPress VIP coding standard errors above, or run `composer lint` to see them for the whole plugin.', file=sys.stderr)
    sys.exit(1)
